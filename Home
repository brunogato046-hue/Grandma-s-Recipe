<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Grandma's Recipe</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>
/* ── Reset & base ── */
*,
*::before,
*::after {
margin: 0;
padding: 0;
box-sizing: border-box;
}

:root {
--pink-primary: #ff6b8a;
--pink-secondary: #ff8fa3;
--pink-light: #ffb3c6;
--pink-lighter: #ffe5ec;
--pink-bg: #fff5f7;
--white: #ffffff;
--text-dark: #3d2c2e;
--text-soft: #5e4a4d;
--shadow-sm: 0 4px 20px rgba(255, 107, 138, 0.12);
--shadow-hover: 0 12px 40px rgba(255, 107, 138, 0.22);
--radius: 20px;
--radius-sm: 12px;
--transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

html {
scroll-behavior: smooth;
}

body {
font-family: 'Inter', sans-serif;
background: var(--pink-bg);
color: var(--text-dark);
line-height: 1.6;
overflow-x: hidden;
}

h1,
h2,
h3,
h4 {
font-family: 'Playfair Display', serif;
font-weight: 700;
letter-spacing: -0.01em;
}

a {
text-decoration: none;
color: inherit;
}
img {
max-width: 100%;
display: block;
}

.container {
max-width: 1200px;
margin: 0 auto;
padding: 0 24px;
}

/* ── Scrollbar ── */
::-webkit-scrollbar {
width: 8px;
}
::-webkit-scrollbar-track {
background: var(--pink-lighter);
}
::-webkit-scrollbar-thumb {
background: var(--pink-primary);
border-radius: 10px;
}

/* ── Header ── */
.header {
background: rgba(255, 255, 255, 0.82);
backdrop-filter: blur(16px);
-webkit-backdrop-filter: blur(16px);
border-bottom: 2px solid rgba(255, 107, 138, 0.10);
position: sticky;
top: 0;
z-index: 100;
padding: 14px 0;
transition: var(--transition);
}

.header .container {
display: flex;
align-items: center;
justify-content: space-between;
flex-wrap: wrap;
gap: 16px;
}

.logo {
display: flex;
align-items: center;
gap: 14px;
}

.logo svg {
width: 54px;
height: 54px;
flex-shrink: 0;
filter: drop-shadow(0 2px 8px rgba(255, 107, 138, 0.20));
transition: var(--transition);
}

.logo:hover svg {
transform: scale(1.04) rotate(-2deg);
}

.logo-text {
font-family: 'Playfair Display', serif;
font-size: 1.6rem;
font-weight: 700;
color: var(--text-dark);
letter-spacing: -0.02em;
}
.logo-text span {
color: var(--pink-primary);
}

.nav {
display: flex;
align-items: center;
gap: 32px;
}

.nav a {
font-weight: 500;
font-size: 0.95rem;
color: var(--text-soft);
transition: var(--transition);
position: relative;
}

.nav a::after {
content: '';
position: absolute;
bottom: -4px;
left: 0;
width: 0;
height: 2.5px;
background: var(--pink-primary);
border-radius: 4px;
transition: var(--transition);
}

.nav a:hover {
color: var(--pink-primary);
}
.nav a:hover::after {
width: 100%;
}

.nav .btn-nav {
background: var(--pink-primary);
color: #fff;
padding: 10px 26px;
border-radius: 50px;
font-weight: 600;
font-size: 0.9rem;
transition: var(--transition);
box-shadow: 0 4px 14px rgba(255, 107, 138, 0.30);
}

.nav .btn-nav::after {
display: none;
}
.nav .btn-nav:hover {
background: #e85a7a;
transform: translateY(-2px);
box-shadow: 0 8px 24px rgba(255, 107, 138, 0.40);
color: #fff;
}

/* Hamburger */
.hamburger {
display: none;
flex-direction: column;
gap: 5px;
cursor: pointer;
padding: 4px;
background: none;
border: none;
}
.hamburger span {
width: 28px;
height: 3px;
background: var(--text-dark);
border-radius: 6px;
transition: var(--transition);
}

/* ── Hero ── */
.hero {
padding: 60px 0 70px;
background: linear-gradient(135deg, #fff5f7 0%, #ffe5ec 100%);
position: relative;
overflow: hidden;
}

.hero::before {
content: '';
position: absolute;
top: -30%;
right: -10%;
width: 500px;
height: 500px;
background: radial-gradient(circle, rgba(255, 179, 198, 0.30) 0%, transparent 70%);
border-radius: 50%;
pointer-events: none;
}

.hero::after {
content: '';
position: absolute;
bottom: -20%;
left: -8%;
width: 400px;
height: 400px;
background: radial-gradient(circle, rgba(255, 107, 138, 0.10) 0%, transparent 70%);
border-radius: 50%;
pointer-events: none;
}

.hero .container {
position: relative;
z-index: 2;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 50px;
align-items: center;
}

.hero-content h1 {
font-size: 3.6rem;
line-height: 1.15;
margin-bottom: 18px;
color: var(--text-dark);
}

.hero-content h1 span {
color: var(--pink-primary);
position: relative;
}

.hero-content h1 span::after {
content: '❤️';
font-size: 2rem;
margin-left: 6px;
}

.hero-content p {
font-size: 1.15rem;
color: var(--text-soft);
max-width: 460px;
margin-bottom: 32px;
line-height: 1.8;
}

.hero-buttons {
display: flex;
flex-wrap: wrap;
gap: 16px;
}

.btn-primary {
background: var(--pink-primary);
color: #fff;
padding: 14px 38px;
border-radius: 50px;
font-weight: 600;
font-size: 1rem;
transition: var(--transition);
box-shadow: 0 4px 18px rgba(255, 107, 138, 0.35);
display: inline-flex;
align-items: center;
gap: 10px;
}

.btn-primary:hover {
background: #e85a7a;
transform: translateY(-3px);
box-shadow: 0 10px 32px rgba(255, 107, 138, 0.45);
}

.btn-secondary {
background: var(--white);
color: var(--text-dark);
padding: 14px 34px;
border-radius: 50px;
font-weight: 600;
font-size: 1rem;
transition: var(--transition);
border: 2px solid var(--pink-light);
display: inline-flex;
align-items: center;
gap: 10px;
}

.btn-secondary:hover {
border-color: var(--pink-primary);
color: var(--pink-primary);
transform: translateY(-3px);
box-shadow: 0 8px 24px rgba(255, 107, 138, 0.12);
}

.hero-stats {
display: flex;
gap: 40px;
margin-top: 40px;
padding-top: 32px;
border-top: 2px solid rgba(255, 107, 138, 0.12);
}

.hero-stats .stat h3 {
font-size: 1.8rem;
color: var(--pink-primary);
font-family: 'Playfair Display', serif;
}
.hero-stats .stat p {
font-size: 0.9rem;
color: var(--text-soft);
font-weight: 500;
}

.hero-image {
display: flex;
justify-content: center;
align-items: center;
position: relative;
}

.hero-image .decoration {
position: absolute;
width: 300px;
height: 300px;
border-radius: 50%;
background: radial-gradient(circle, rgba(255, 179, 198, 0.25) 0%, transparent 70%);
z-index: 0;
animation: float 6s ease-in-out infinite;
}

.hero-image .decoration:nth-child(2) {
width: 200px;
height: 200px;
background: radial-gradient(circle, rgba(255, 107, 138, 0.12) 0%, transparent 70%);
animation-delay: -2s;
animation-duration: 8s;
}

.hero-image svg {
width: 100%;
max-width: 420px;
height: auto;
position: relative;
z-index: 1;
filter: drop-shadow(0 12px 40px rgba(255, 107, 138, 0.18));
transition: var(--transition);
}

.hero-image svg:hover {
transform: scale(1.02) rotate(1deg);
}

@keyframes float {
0%,
100% {
transform: translateY(0px);
}
50% {
transform: translateY(-18px);
}
}

/* ── Section titles ── */
.section-title {
text-align: center;
margin-bottom: 48px;
}

.section-title h2 {
font-size: 2.6rem;
color: var(--text-dark);
margin-bottom: 8px;
}

.section-title h2 span {
color: var(--pink-primary);
}

.section-title p {
color: var(--text-soft);
font-size: 1.05rem;
max-width: 500px;
margin: 0 auto;
}

/* ── Categories ── */
.categories {
padding: 70px 0 50px;
}

.category-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
gap: 20px;
}

.category-card {
background: var(--white);
padding: 28px 16px;
border-radius: var(--radius);
text-align: center;
transition: var(--transition);
box-shadow: var(--shadow-sm);
border: 2px solid transparent;
cursor: default;
}

.category-card:hover {
transform: translateY(-6px);
box-shadow: var(--shadow-hover);
border-color: var(--pink-light);
}

.category-card .icon {
font-size: 2.6rem;
margin-bottom: 8px;
}
.category-card h4 {
font-family: 'Inter', sans-serif;
font-weight: 600;
font-size: 1rem;
color: var(--text-dark);
}
.category-card p {
font-size: 0.8rem;
color: var(--text-soft);
margin-top: 2px;
}

/* ── Featured recipes ── */
.featured {
padding: 40px 0 70px;
}

.recipe-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
gap: 30px;
}

.recipe-card {
background: var(--white);
border-radius: var(--radius);
overflow: hidden;
box-shadow: var(--shadow-sm);
transition: var(--transition);
border: 2px solid transparent;
}

.recipe-card:hover {
transform: translateY(-10px);
box-shadow: var(--shadow-hover);
border-color: var(--pink-light);
}

.recipe-card .card-img {
height: 200px;
background: var(--pink-lighter);
display: flex;
align-items: center;
justify-content: center;
font-size: 4rem;
position: relative;
overflow: hidden;
}

.recipe-card .card-img .badge {
position: absolute;
top: 14px;
right: 14px;
background: var(--pink-primary);
color: #fff;
font-size: 0.7rem;
font-weight: 600;
padding: 4px 14px;
border-radius: 50px;
letter-spacing: 0.3px;
}

.recipe-card .card-body {
padding: 22px 24px 26px;
}

.recipe-card .card-body h3 {
font-family: 'Playfair Display', serif;
font-size: 1.3rem;
margin-bottom: 6px;
}

.recipe-card .card-body .meta {
display: flex;
gap: 18px;
font-size: 0.85rem;
color: var(--text-soft);
margin: 10px 0 14px;
}

.recipe-card .card-body .meta span {
display: flex;
align-items: center;
gap: 5px;
}

.recipe-card .card-body .desc {
color: var(--text-soft);
font-size: 0.95rem;
line-height: 1.6;
}

.recipe-card .card-body .btn-recipe {
margin-top: 16px;
display: inline-block;
font-weight: 600;
color: var(--pink-primary);
transition: var(--transition);
font-size: 0.95rem;
}

.recipe-card .card-body .btn-recipe:hover {
color: #e85a7a;
transform: translateX(6px);
}

/* ── About / Story ── */
.story {
padding: 60px 0 70px;
background: var(--white);
}

.story .container {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 50px;
align-items: center;
}

.story-content h2 {
font-size: 2.4rem;
margin-bottom: 14px;
}

.story-content h2 span {
color: var(--pink-primary);
}

.story-content p {
color: var(--text-soft);
font-size: 1.05rem;
line-height: 1.8;
margin-bottom: 18px;
}

.story-content .signature {
font-family: 'Playfair Display', serif;
font-size: 1.4rem;
color: var(--pink-primary);
margin-top: 8px;
}

.story-image {
display: flex;
justify-content: center;
align-items: center;
}

.story-image svg {
width: 100%;
max-width: 380px;
height: auto;
filter: drop-shadow(0 8px 30px rgba(255, 107, 138, 0.12));
}

/* ── Newsletter ── */
.newsletter {
padding: 60px 0;
background: linear-gradient(135deg, #ffe5ec 0%, #fff5f7 100%);
}

.newsletter-box {
background: var(--white);
border-radius: var(--radius);
padding: 50px 40px;
text-align: center;
max-width: 720px;
margin: 0 auto;
box-shadow: var(--shadow-sm);
border: 2px solid rgba(255, 107, 138, 0.08);
}

.newsletter-box h2 {
font-size: 2rem;
margin-bottom: 8px;
}

.newsletter-box h2 span {
color: var(--pink-primary);
}

.newsletter-box p {
color: var(--text-soft);
margin-bottom: 24px;
}

.newsletter-form {
display: flex;
flex-wrap: wrap;
gap: 12px;
justify-content: center;
}

.newsletter-form input {
flex: 1;
min-width: 220px;
padding: 14px 22px;
border: 2px solid var(--pink-lighter);
border-radius: 50px;
font-size: 1rem;
outline: none;
transition: var(--transition);
background: var(--pink-bg);
}

.newsletter-form input:focus {
border-color: var(--pink-primary);
box-shadow: 0 0 0 4px rgba(255, 107, 138, 0.10);
}

.newsletter-form button {
background: var(--pink-primary);
color: #fff;
border: none;
padding: 14px 36px;
border-radius: 50px;
font-weight: 600;
font-size: 1rem;
cursor: pointer;
transition: var(--transition);
box-shadow: 0 4px 14px rgba(255, 107, 138, 0.30);
}

.newsletter-form button:hover {
background: #e85a7a;
transform: translateY(-2px);
box-shadow: 0 8px 28px rgba(255, 107, 138, 0.40);
}

/* ── Footer ── */
.footer {
background: #2d1e20;
color: rgba(255, 255, 255, 0.80);
padding: 50px 0 30px;
}

.footer .container {
display: grid;
grid-template-columns: 2fr 1fr 1fr 1fr;
gap: 40px;
}

.footer-brand .logo-text {
color: #fff;
font-size: 1.5rem;
}
.footer-brand .logo-text span {
color: var(--pink-light);
}

.footer-brand p {
font-size: 0.95rem;
margin-top: 10px;
max-width: 280px;
line-height: 1.7;
opacity: 0.75;
}

.footer-social {
display: flex;
gap: 14px;
margin-top: 18px;
}

.footer-social a {
background: rgba(255, 255, 255, 0.08);
width: 42px;
height: 42px;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-size: 1.2rem;
transition: var(--transition);
}

.footer-social a:hover {
background: var(--pink-primary);
transform: translateY(-3px);
}

.footer h4 {
font-family: 'Inter', sans-serif;
font-weight: 600;
font-size: 1rem;
color: #fff;
margin-bottom: 16px;
letter-spacing: 0.3px;
}

.footer ul {
list-style: none;
display: flex;
flex-direction: column;
gap: 10px;
}

.footer ul a {
opacity: 0.75;
transition: var(--transition);
font-size: 0.95rem;
}

.footer ul a:hover {
opacity: 1;
color: var(--pink-light);
}

.footer-bottom {
grid-column: 1 / -1;
border-top: 1px solid rgba(255, 255, 255, 0.08);
padding-top: 24px;
margin-top: 20px;
text-align: center;
font-size: 0.9rem;
opacity: 0.6;
}

/* ── Responsive ── */
@media (max-width: 992px) {
.hero .container {
grid-template-columns: 1fr;
text-align: center;
}

.hero-content p {
margin-left: auto;
margin-right: auto;
}

.hero-buttons {
justify-content: center;
}

.hero-stats {
justify-content: center;
}

.hero-image svg {
max-width: 320px;
}

.story .container {
grid-template-columns: 1fr;
text-align: center;
}

.story-content p {
margin-left: auto;
margin-right: auto;
}

.footer .container {
grid-template-columns: 1fr 1fr;
}
}

@media (max-width: 768px) {
.nav {
display: none;
flex-direction: column;
width: 100%;
background: var(--white);
padding: 20px 0;
border-radius: var(--radius-sm);
box-shadow: var(--shadow-hover);
position: absolute;
top: 70px;
left: 0;
gap: 16px;
}

.nav.open {
display: flex;
}

.hamburger {
display: flex;
}

.hero-content h1 {
font-size: 2.6rem;
}

.section-title h2 {
font-size: 2rem;
}

.recipe-grid {
grid-template-columns: 1fr 1fr;
}

.footer .container {
grid-template-columns: 1fr;
text-align: center;
}

.footer-brand p {
max-width: 100%;
}

.footer-social {
justify-content: center;
}

.newsletter-box {
padding: 32px 20px;
}

.newsletter-form input {
min-width: 160px;
}
}

@media (max-width: 480px) {
.recipe-grid {
grid-template-columns: 1fr;
}

.hero-content h1 {
font-size: 2.2rem;
}

.hero-stats {
flex-direction: column;
gap: 16px;
align-items: center;
}

.category-grid {
grid-template-columns: repeat(2, 1fr);
}

.logo-text {
font-size: 1.2rem;
}
.logo svg {
width: 42px;
height: 42px;
}
}

/* ── Utility ── */
.text-pink {
color: var(--pink-primary);
}
.text-center {
text-align: center;
}
.mt-8 {
margin-top: 8px;
}
</style>
</head>

